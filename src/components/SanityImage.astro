---
import { sanitySrc, sanitySrcset } from '../lib/image';

interface Props {
  asset?: { url: string; metadata?: { dimensions?: { width: number }; lqip?: string } };
  alt?: string;
  class?: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const { asset, alt = '', class: className, sizes, loading = 'lazy' } = Astro.props;
const nativeWidth = asset?.metadata?.dimensions?.width;
const srcset = asset ? sanitySrcset({ url: asset.url, width: nativeWidth }) : undefined;
// Mirror Webflow's sizes pattern so the intrinsic display width stays the
// image's natural width (a bare `sizes="100vw"` would upscale to viewport).
const defaultSizes = nativeWidth
  ? `(max-width: ${nativeWidth}px) 100vw, ${nativeWidth}px`
  : '100vw';
---

{
  asset && (
    <img
      src={sanitySrc(asset.url)}
      srcset={srcset}
      sizes={srcset ? (sizes ?? defaultSizes) : undefined}
      alt={alt}
      class={className}
      loading={loading}
      decoding="async"
    />
  )
}
