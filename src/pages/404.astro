---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found • Utah UX" bodyClass="body" noindex>
  <div class="section hero">
    <div class="wrapper">
      <div class="container-narrow center-center-horizontal">
        <div class="hero-left">
          <h1 class="h1">Page not found.</h1>
          <div class="p-default hero-p">
            The page you're looking for doesn't exist or has moved.
          </div>
          <div class="ctas">
            <a href="/" class="btn-primary left-btn w-button">Back to Home</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
